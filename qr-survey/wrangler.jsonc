{
  "name": "qr-survey",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "vars": {
    // File name of your PDF inside public/files/
    "PDF_FILE": "brochure.pdf"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // `npx wrangler d1 create qr-survey --location=enam --binding DB` fills in the database_id here.
  "d1_databases": [
    { "binding": "DB", "database_name": "qr-survey" }
  ]
}
